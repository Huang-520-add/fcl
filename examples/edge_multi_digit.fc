GMO ENABLED ;
NUMERIC OUTPUT ;
BIOME {
INTRODUCE Grass_10 AS PRODUCER WITH 10 ;
INTRODUCE Grass_99 AS PRODUCER WITH 99 ;
INTRODUCE Sheep_M3 AS HERBIVORE WITH 0 ;
INTRODUCE Fungus_100 AS DECOMPOSER WITH 0 ;
}
FOODWEB {
Sheep_M3 DEVOURS Grass_10 USING SUM ;
Sheep_M3 DEVOURS Grass_99 USING SUM ;
}
DECAY {
Fungus_100 DEVOURS Sheep_M3 USING SUM ;
ROT Fungus_100 TO STDOUT ;
}
