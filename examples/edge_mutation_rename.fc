NUMERIC OUTPUT ;
BIOME {
INTRODUCE Grass_1 AS PRODUCER WITH 100 ;
INTRODUCE Sheep_M1 AS HERBIVORE WITH 0 ;
INTRODUCE Wolf_M1 AS CARNIVORE WITH 0 ;
INTRODUCE Fungus_1 AS DECOMPOSER WITH 0 ;
}
FOODWEB {
Sheep_M1 DEVOURS Grass_1 USING SUM ;
MUTATION Wolf_M1 {
    CASE "独猎": Wolf_M1 DEVOURS Sheep_M1 USING SUM ;
}
INTRODUCE Grass_9 AS PRODUCER WITH 4*(1-MATCH(Wolf)) ;
}
DECAY {
Fungus_1 DEVOURS Wolf_M1 USING SUM ;
Fungus_1 DEVOURS Grass_9 USING SUM ;
ROT Fungus_1 TO STDOUT ;
ROT Fungus_1 TO STDOUT ;
}
