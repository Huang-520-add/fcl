GMO ENABLED ;
BIOME {
INTRODUCE Wolf_M1 AS CARNIVORE WITH 100 ;
INTRODUCE Sheep_M1 AS HERBIVORE WITH 5 ;
INTRODUCE Fungus_1 AS DECOMPOSER WITH 0 ;
}
FOODWEB {
MIGRATION Wolf_M1 OVER 2 { Wolf_M1 DEVOURS Sheep_M1 USING SUM ; }
}
DECAY {
Fungus_1 DEVOURS Wolf_M1 USING SUM ;
ROT Fungus_1 TO STDOUT ;
ROT Fungus_1 TO STDOUT ;
}
