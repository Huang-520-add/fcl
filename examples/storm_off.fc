GMO ENABLED ;
BIOME {
INTRODUCE Grass_1 AS PRODUCER WITH 1 ;
INTRODUCE Rabbit_1 AS HERBIVORE WITH 0 ;
INTRODUCE Fungus_1 AS DECOMPOSER WITH 0 ;
}
FOODWEB {
Rabbit_1 DEVOURS Grass_1 USING SUM ;
SEASON RAIN {
INTRODUCE Algae_1 AS PRODUCER WITH 1 ;
INTRODUCE Algae_2 AS PRODUCER WITH 2 ;
INTRODUCE Algae_3 AS PRODUCER WITH 3 ;
INTRODUCE Algae_4 AS PRODUCER WITH 4 ;
} DRY { INTRODUCE Algae_5 AS PRODUCER WITH 5 ; }
}
DECAY {
Fungus_1 DEVOURS Rabbit_1 USING SUM ;
ROT Fungus_1 TO STDOUT ;
ROT Fungus_1 TO STDOUT ;
}
