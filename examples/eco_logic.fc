GMO ENABLED ;
BIOME {
INTRODUCE Grass_1 AS PRODUCER WITH 30+35 ;
INTRODUCE Grass_2 AS PRODUCER WITH 20 ;
INTRODUCE Sheep_M1 AS HERBIVORE WITH 0 ;
INTRODUCE Wolf_M1 AS CARNIVORE WITH 0 ;
INTRODUCE Alpha_Wolf AS CARNIVORE WITH 0 ;
INTRODUCE Lion_M1 AS APEX WITH 0 ;
INTRODUCE Lion_F1 AS APEX WITH 0 ;
INTRODUCE Tiger_1 AS APEX WITH 0 ;
}
FOODWEB {
Sheep_M1 DEVOURS Grass_1 USING SUM ;
Wolf_M1 DEVOURS Sheep_M1 USING SUM ;
ASSESS Wolf_M1 AGAINST Sheep_M1 TO Lion_M1 ;
ASSESS Grass_2 AGAINST Grass_1 TO Lion_F1 ;
SYMBIOSIS Lion_M1 WITH Lion_F1 TO Tiger_1 ;
COMPETITION Lion_M1 OR Lion_F1 TO Tiger_1 ;
MIMICRY Tiger_1 TO Lion_F1 ;
}
DECAY {
INTRODUCE Fungus_1 AS DECOMPOSER WITH 0 ;
Fungus_1 DEVOURS Lion_F1 USING SUM ;
ROT Fungus_1 TO STDOUT ;
ROT Fungus_1 TO STDOUT ;
}
