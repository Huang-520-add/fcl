GMO ENABLED ;
NUMERIC OUTPUT ;
BIOME {
INTRODUCE Grass_1 AS PRODUCER WITH 3 ;
INTRODUCE Grass_2 AS PRODUCER WITH 4 ;
INTRODUCE Sheep_M1 AS HERBIVORE WITH 0 ;
}
FOODWEB {
Sheep_M1 DEVOURS Grass_1 USING SUM ;
Sheep_M1 DEVOURS Grass_2 USING SUM ;
SEASON RAIN { INTRODUCE Algae_1 AS PRODUCER WITH 7 ; } DRY { INTRODUCE Algae_1 AS PRODUCER WITH 9 ; }
}
DECAY {
INTRODUCE Fungus_1 AS DECOMPOSER WITH 0 ;
Fungus_1 DEVOURS Algae_1 USING SUM ;
ROT Fungus_1 TO STDOUT ;
}
