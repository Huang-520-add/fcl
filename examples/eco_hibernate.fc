GMO ENABLED ;
BIOME {
INTRODUCE Grass_1 AS PRODUCER WITH 1 ;
INTRODUCE Rabbit_1 AS HERBIVORE WITH 0 ;
INTRODUCE Lion_F1 AS APEX WITH 1 ;
INTRODUCE Tiger_1 AS APEX WITH 0 ;
INTRODUCE Fungus_1 AS DECOMPOSER WITH 100 ;
}
FOODWEB {
Rabbit_1 DEVOURS Grass_1 USING SUM ;
HIBERNATION Fungus_1 UNTIL Tiger_1 {
MIMICRY Lion_F1 TO Tiger_1 ;
SYMBIOSIS Lion_F1 WITH Tiger_1 TO Lion_F1 ;
}
}
DECAY {
ROT Fungus_1 TO STDOUT ;
ROT Fungus_1 TO STDOUT ;
}
