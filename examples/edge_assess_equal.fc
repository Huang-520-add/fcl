GMO ENABLED ;
NUMERIC OUTPUT ;
BIOME {
INTRODUCE Grass_1 AS PRODUCER WITH 30 ;
INTRODUCE Grass_2 AS PRODUCER WITH 30 ;
INTRODUCE Sheep_M1 AS HERBIVORE WITH 0 ;
INTRODUCE Sheep_M2 AS HERBIVORE WITH 0 ;
INTRODUCE Tiger_1 AS APEX WITH 0 ;
}
FOODWEB {
Sheep_M1 DEVOURS Grass_1 USING SUM ;
Sheep_M2 DEVOURS Grass_2 USING SUM ;
ASSESS Sheep_M1 AGAINST Sheep_M2 TO Tiger_1 ;
}
DECAY {
INTRODUCE Fungus_1 AS DECOMPOSER WITH 0 ;
Fungus_1 DEVOURS Tiger_1 USING SUM ;
ROT Fungus_1 TO STDOUT ;
}
