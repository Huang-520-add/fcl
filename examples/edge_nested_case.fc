NUMERIC OUTPUT ;
BIOME { INTRODUCE Grass_1 AS PRODUCER WITH 100 ; INTRODUCE Grass_2 AS PRODUCER WITH 7 ; INTRODUCE Sheep_M1 AS HERBIVORE WITH 0 ; INTRODUCE Wolf_M1 AS CARNIVORE WITH 0 ; INTRODUCE Fungus_1 AS DECOMPOSER WITH 0 ; }
FOODWEB { Sheep_M1 DEVOURS Grass_1 USING SUM ; MUTATION Wolf_M1 { CASE "外层": MUTATION Wolf_M1 { CASE "内层": Wolf_M1 DEVOURS Sheep_M1 USING SUM ; } ; CASE "分支B": CLONE Wolf_M1 FROM Grass_2 ; } }
DECAY { Fungus_1 DEVOURS Wolf_M1 USING SUM ; ROT Fungus_1 TO STDOUT ; ROT Fungus_1 TO STDOUT ; }
